// Main routine
begin
    // A Koala Painter image typically contains:
    //
    // Section	       	Address (offset)	Size
    // Header byte	   	$0000	2 bytes 		($0	  	- $2)
    // Bitmap data	   	$0002	8000 bytes 	($2	  	- $1F41)
    // Screen RAM	   	$1F42	1000 bytes 	($1F42	- $2329)
    // Color RAM	       	$232A	1000 bytes 	($232A	- $2711)
    // Background color	$2712	1 byte		($2712)
    
    // Use memory locations:
    // Bitmap data: $2000 VIC ($6000 CPU)
    // Screen RAM: $0400 VIC ($4400 CPU)
    // Color RAM: $D800
    // VIC-II screen control: $D011, $D016, etc
    
    // This example displays a Koala image assuming it's loaded at $6000.
	DefineScreen(); 
	preventirq();
	disableciainterrupts();
	irq_save_lo		:= peek(^$0314, 0);	// Save old IRQ handler address 
	irq_save_hi		:= peek(^$0315, 0);	// for when we exit.
	//irq_save_vic		:= peek(^$D019, 0);	// Save VICIRCL value
	irq_save_mask	:= peek(^$D01A, 0);	// Save IRQMSK value

	SetMemoryConfig(1,USE_KERNAL,0); // Enable I/O, Enable KERNAL, Disable BASIC

	// Play sid file
	InitSid(sidfile_1_init);
	//StartRasterChain(irSidPlayer(),$50,USE_KERNAL);

	// Configure raster IRQ
	RasterIRQ(irSidPlayer(),$50,USE_KERNAL);
	enablerasterirq();
	enableirq();
	
	// Show Koala image	
	displayKoalaScreen();
	
	initSprites();
	
	while (true) do 
	begin		
		waitforraster(0);
		//SCREEN_BG_COL[0] := cyan; // for testing speed
		
		// Check if pattern should be updated		
		if (anim_pattern_ctr = 0) then begin
			update_animation_pattern();
		end;
		dec(anim_pattern_ctr);

		// Update sprite definition pointers
		if (sprite_anim_ctr = 0) then begin			
			update_sprite_pointers();

			// Reset animation counter
			sprite_anim_ctr := SPRITE_ANIM_DEF;
		end;
		dec(sprite_anim_ctr);

		// Update positions of sprites
		update_sprite_positions();

		// text scrolling animation 
		scrollMessageSprites();
		
		// Check for space bar pressed
		//Key::Read();
		//if (Key::Held(KEY_KSPACE)) then begin			
		//	load_menu(); // Load & Run MENU.PRG 
		//end;
		
		//SCREEN_BG_COL[0] := blue; // for testing speed
	end;

	loop();
end.
