// Set sprite colors
procedure set_sprite_colors();
begin
	SPRITE_COLOR[0]	:= title_text_color;
	SPRITE_COLOR[1]	:= title_text_color;
	SPRITE_COLOR[2]	:= title_text_color;
	SPRITE_COLOR[3]	:= title_text_color;
	SPRITE_COLOR[4]	:= title_text_color;
	SPRITE_COLOR[5]	:= title_text_color;
	SPRITE_COLOR[6]	:= title_text_color;
	SPRITE_COLOR[7]	:= title_text_color;
end;

// Show Koala-format image
procedure displayKoalaScreen();
begin
	SetBank(VIC_BANK1);	// Bank #1, $4000-$7FFF
	SetBitmapMode();	// Enable bitmap
	SetMultiColorMode();	// Enable MC
	
	// $D018 VIC-II Chip Memory Control Register
	//
	// Bit 0: Unused
	// Bits 1-3: Text character dot-data base address within VIC-II address space
	// Bits 4-7: Video matrix base address within VIC-II address space
	//
	// Set screen address to $5C00 CPU ($1C00 VIC)
	// Set bitmap loc to $6000 CPU ($2000 VIC) 
	// Sprite data loads at $4000 CPU ($0000 VIC) - Allowing room for up to 106 sprite definitions
	// Theoretically, there should be 384 bytes free at $1A80-$1BFF but TRSE throws an error.
	poke(^$D018, 0, %01111100);
	
	// Copy bitmap data
	BlockMemCpy(^$8002, LOC_BITMAP_SCREEN, 16); // Copy 4,096 bytes
	BlockMemCpy(^$9002, LOC_BITMAP_SCREEN + $1000, 16); // Copy 4,096 bytes
	
	// Copy screen memory
	BlockMemCpy(^$9F42, LOC_CHAR_SCREEN, 4);
	
	// Copy color memory
	BlockMemCpy(^$A32A, LOC_CHAR_COLOR, 4);

	// Set BG/Border colors
	SCREEN_BG_COL[0] := blue;
	SCREEN_FG_COL[0] := Peek(^$A712, 0);
end;

// Sprites 0-2 are multiplexed and defined in separate functions
// Sprites 3-7 are static
procedure initSprites_mode1();
begin
	// Hardware sprites that are multiplexed: 0, 1, 2
	// No need to define these here, because they get initialized on every frame.
	
	// Hardware sprites that appear continually:
	// "Band A" HW sprite 4
	// "Band B" HW sprites 5 & 6
	// "Band C" HW sprite 7
	LOC_SPRITE_PTRS[4]	:= title_spr_arr[4];
	LOC_SPRITE_PTRS[5]	:= title_spr_arr[8];
	LOC_SPRITE_PTRS[6]	:= title_spr_arr[9];
	LOC_SPRITE_PTRS[7]	:= title_spr_arr[10];
	SpritePos(title_spr_xpos_arr[4], title_spr_ypos_arr[4], 4);
	SpritePos(title_spr_xpos_arr[8], title_spr_ypos_arr[8], 5);
	SpritePos(title_spr_xpos_arr[9], title_spr_ypos_arr[9], 6);
	SpritePos(title_spr_xpos_arr[10], title_spr_ypos_arr[10], 7);	
end;

// Shows Psyche! and troll face
procedure initSprites_mode2();
begin
	// Enable sprites 0-3
	//SPRITE_BITMASK			:= %00000111;
	//SPRITE_STRETCH_X			:= SPRITE_STRETCH_X | %11111111;
	//SPRITE_STRETCH_Y			:= SPRITE_STRETCH_Y | %11111111;
	//SPRITE_MULTICOLOR		:= %00000111;

	//LOC_SPRITE_PTRS[0]	:= title_spr_arr[11];
	//LOC_SPRITE_PTRS[1]	:= title_spr_arr[12];
	//LOC_SPRITE_PTRS[2]	:= title_spr_arr[13];
	//SpritePos(title_spr_xpos_arr[11], title_spr_ypos_arr[11], 0);
	//SpritePos(title_spr_xpos_arr[12], title_spr_ypos_arr[12], 1);
	//SpritePos(title_spr_xpos_arr[13], title_spr_ypos_arr[13], 2);
